<?xml version="1.0"?>
<page
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="page.actions.toolbar">
            <block
                class="Stoneholl\OrderNavigation\Block\Adminhtml\Navigation"
                name="stoneholl.order_navigation.actions"
                before="-"
                template="Stoneholl_OrderNavigation::actions.phtml"/>
        </referenceBlock>
        <referenceContainer name="order_additional_info">
            <block
                class="Stoneholl\OrderNavigation\Block\Adminhtml\Navigation"
                name="stoneholl.order_navigation"
                after="stoneholl.related_customer_orders"
                before="stoneholl.customer_local_time"
                template="Stoneholl_OrderNavigation::navigation.phtml">
                <arguments>
                    <argument name="sort_order" xsi:type="number">20</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
