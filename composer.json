{
    "name": "stoneholl/magento2-order-navigation",
    "description": "Offline same-store previous and next order navigation for Magento 2 Admin.",
    "type": "magento2-module",
    "license": "MIT",
    "require": {
        "php": "~7.4.0||~8.0.0||~8.1.0||~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "stoneholl/magento2-core": "^1.0.1",
        "magento/framework": "102.0.*||103.0.*",
        "magento/module-backend": "101.0.*||102.0.*",
        "magento/module-config": "101.1.*||101.2.*",
        "magento/module-sales": "102.0.*||103.0.*",
        "magento/module-store": "101.0.*||101.1.*",
        "psr/log": "^1.0||^2.0||^3.0"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Stoneholl\\OrderNavigation\\": ""
        }
    },
    "replace": {
        "stoneholl/module-order-navigation": "self.version"
    },
    "keywords": [
        "magento2",
        "magento",
        "magento 2",
        "magento2 module",
        "magento open source",
        "magento 2 extension",
        "admin",
        "orders",
        "order navigation"
    ]
}
